# ============================================
# Database — Neon PostgreSQL (Vercel Storage)
# Create a Neon database at:
# https://console.neon.tech
# Then set this in Vercel Dashboard > Settings > Environment Variables
# ============================================
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:npg_P25SIDbkJyiR@ep-super-shadow-awnoi05k.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ============================================
# JWT Secret — Generate a strong random key
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ============================================
# Frontend URL — for CORS
# In Vercel, this is auto-set from the deployment URL
# ============================================
# FRONTEND_URL="https://your-app.vercel.app"

# ============================================
# Rate limiting (optional)
# ============================================
# RATE_LIMIT_MAX=2000

# ============================================
# Node environment
# ============================================
NODE_ENV=production
