# ============================================
# CRM Inventario — Variables de Entorno
# Copia este archivo a `.env` y ajusta los valores.
# ============================================

# --- Base de datos ---
# Deja DATABASE_URL vacío para usar SQLite local (recomendado para desarrollo).
# Para producción usa PostgreSQL (ej. Neon):
#   DATABASE_URL=postgresql://usuario:clave@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Seguridad ---
# Clave secreta para firmar tokens JWT (mín. 32 caracteres en producción).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-segura-de-al-menos-32-caracteres

# --- CORS (opcional) ---
# URL pública del frontend para permitir CORS en producción.
# FRONTEND_URL=https://tu-dominio.com

# --- Rate limiting (opcional) ---
# Máximo de solicitudes por ventana de 15 minutos.
# RATE_LIMIT_MAX=2000

# --- Logs (opcional) ---
# Nivel de log: debug | info | warn | error
# LOG_LEVEL=info

# --- Google Maps (frontend) ---
# Clave de API para el mapa en tiempo real del delivery.
# Debe crearse en Google Cloud Console habilitando:
#   - Maps JavaScript API
#   - Geocoding API
# Este archivo va en el FRONTEND: copia a frontend/.env y pega tu clave.
VITE_GOOGLE_MAPS_API_KEY=TU_CLAVE_AQUI
